ENV=development
ALLOWED_ORIGINS=["http://localhost:2000"]

RATE_LIMIT_EXTRACT=20/minute
RATE_LIMIT_DOWNLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute

YTDLP_SOCKET_TIMEOUT=15
# In production, YouTube blocks datacenter/VPS IPs with "Sign in to confirm
# you're not a bot" unless a real browser session's cookies are supplied.
# See deploy/README.md for how to generate this file.
YTDLP_COOKIES_FILE=/app/cookies/youtube.txt
MAX_EXTRACT_CONCURRENCY=8

DOWNLOAD_CHUNK_SIZE=262144
UPSTREAM_TIMEOUT_SECONDS=30
MAX_ALLOWED_FILESIZE_BYTES=5368709120

# Optional: enables the authenticated instagrapi fallback in services/instagram.py
IG_USERNAME=
IG_PASSWORD=
IG_SESSION_PATH=sessions/ig_session.json
